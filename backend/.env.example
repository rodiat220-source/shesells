# LLM配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=gpt-4

# SSL 证书验证（默认 true，代理环境下可设为 false）
LLM_VERIFY_SSL=true

# HTTP 代理（可选，例如 http://127.0.0.1:7890）
LLM_HTTP_PROXY=

# Langfuse Cloud（填写项目设置中的 API Keys）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
